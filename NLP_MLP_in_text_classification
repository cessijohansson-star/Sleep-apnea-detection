        "# Your code to train the machine learning model on the training set and evaluate the performance on the validation set here\n",
        "# Same construction as in the exercises done in the course\n",
        "class MLPConfig(transformers.PretrainedConfig):\n",
        "  pass\n",
        "\n",
        "class MLP(transformers.PreTrainedModel):\n",
        "    config_class = MLPConfig\n",
        "    def __init__(self, config):\n",
        "      super().__init__(config)\n",
        "\n",
        "      self.all_tied_weights_keys = {}\n",
        "      self.vocab_size=config.vocab_size\n",
        "      assert tokenizer.vocab[\"[PAD]\"]==0\n",
        "      self.embedding=torch.nn.Embedding(num_embeddings=self.vocab_size,embedding_dim=config.hidden_size,padding_idx=0)\n",
        "      torch.nn.init.uniform_(self.embedding.weight.data,-0.001,0.001)\n",
        "      self.output=torch.nn.Linear(in_features=config.hidden_size,out_features=config.nlabels)\n",
        "      self.loss=torch.nn.CrossEntropyLoss()\n",
        "\n",
        "    def forward(self,input_ids,labels=None,**kwargs):\n",
        "      embeddings=self.embedding(input_ids)\n",
        "      embedded_summed=torch.sum(embeddings,dim=1)\n",
        "      projected=embedded_summed\n",
        "      logits=self.output(projected)\n",
        "      if labels is not None:\n",
        "          return (self.loss(logits,labels),logits)\n",
        "      else:\n",
        "          return (logits,)\n"
      ],
